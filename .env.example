# Provider-agnostic LLM (any OpenAI-compatible host)
# Works with OpenAI, OpenRouter, Groq, Together, Fireworks, Azure gateways,
# Ollama (http://localhost:11434/v1), LM Studio, vLLM, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional: separate judge / gap-reader model (F5). Falls back to LLM_MODEL.
# LLM_JUDGE_MODEL=gpt-4o-mini
# Optional multi-judge ensemble (comma-separated; W15)
# LLM_JUDGE_MODELS=gpt-4o-mini,gpt-4o
# Optional: force response_format=json_object (many local models reject this)
# LLM_JSON_MODE=false
# Chat completion timeout seconds (default 90)
# LLM_TIMEOUT_S=90

# Backward-compatible aliases (still honored)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# OpenAlex polite pool (recommended: your email)
OPENALEX_MAILTO=curiosity@localhost

# Optional Semantic Scholar API key (higher rate limits; public search works without)
# S2_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

# Literature HTTP timeout seconds (default 12)
# LITERATURE_TIMEOUT_S=12

# Optional HTTP API auth (unset = open local demo; set a key before binding 0.0.0.0)
# Non-loopback also needs CURIOSITY_ALLOW_NONLOCAL_BIND=1 on `emotions serve`.
# CURIOSITY_API_KEY=
# ARTIFICIAL_CURIOSITY_API_KEY=
# CURIOSITY_API_KEYS=key1,key2

# CORS origins (default empty = deny). Opt-in comma list, or * if you truly need open CORS.
# CURIOSITY_CORS_ORIGINS=http://127.0.0.1:3000

# In-process HTTP rate limit per client host (default 60 / 60s; 0 disables). Not a WAF.
# CURIOSITY_API_RATE_LIMIT_PER_MINUTE=60

# Opt-in per-key HTTP request budget (unset/0 = no quota, local DX unchanged).
# Requires CURIOSITY_API_KEY / CURIOSITY_API_KEYS — unmatched keys are not bucketed.
# CURIOSITY_API_QUOTA_REQUESTS=1000
# Sliding window seconds for the quota (default 86400). Ignored when quota is off.
# CURIOSITY_API_QUOTA_WINDOW_S=86400

# Opt-in JSONL audit of HTTP method+path and MCP tool name + status (default off).
# Never logs request/response bodies, headers, or API keys.
# CURIOSITY_AUDIT_LOG=

# Serve defaults (bind 127.0.0.1 for local demos).
# Non-loopback (0.0.0.0 / LAN) is refused by `emotions serve` unless:
# CURIOSITY_ALLOW_NONLOCAL_BIND=1
# Also set CURIOSITY_API_KEY before exposing the port. Still not TLS.
# CURIOSITY_HOST=127.0.0.1
# CURIOSITY_PORT=8000

# MCP progressive disclosure (core | investigate | affect | research | full — default full)
# `full` includes all tool groups; other tiers expose their documented subset.
# CURIOSITY_MCP_TIER=full

# Persistent CLI memory (default path ~/.artificial_emotions/memory.json).
# Set to 1 to disable all read/write — byte-identical offline behaviour.
# Never on by default for MCP/HTTP; CLI explore persists unless --no-memory.
# CURIOSITY_NO_MEMORY=1
# Optional path override (tests / custom location):
# CURIOSITY_MEMORY_PATH=

# Optional temperament.toml path (A5). Default ~/.artificial_emotions/temperament.toml.
# explore(..., temperament=None) ignores the file; pass a preset or "custom" to apply.
# CURIOSITY_TEMPERAMENT_PATH=

# See artificial_emotions.config for the central env reference.
