# Provider-agnostic LLM (any OpenAI-compatible host)
# Works with OpenAI, OpenRouter, Groq, Together, Fireworks, Azure gateways,
# Ollama (http://localhost:11434/v1), LM Studio, vLLM, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional: separate judge / gap-reader model (F5). Falls back to LLM_MODEL.
# LLM_JUDGE_MODEL=gpt-4o-mini
# Optional multi-judge ensemble (comma-separated; W15)
# LLM_JUDGE_MODELS=gpt-4o-mini,gpt-4o
# Optional: force response_format=json_object (many local models reject this)
# LLM_JSON_MODE=false
# Chat completion timeout seconds (default 90)
# LLM_TIMEOUT_S=90

# Backward-compatible aliases (still honored)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# OpenAlex polite pool (recommended: your email)
OPENALEX_MAILTO=curiosity@localhost

# Optional Semantic Scholar API key (higher rate limits; public search works without)
# S2_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

# Literature HTTP timeout seconds (default 12)
# LITERATURE_TIMEOUT_S=12

# Optional HTTP API auth (unset = open local demo)
# CURIOSITY_API_KEY=
# ARTIFICIAL_CURIOSITY_API_KEY=
# CURIOSITY_API_KEYS=key1,key2

# CORS origins (default * for local demos; comma-list to tighten)
# CURIOSITY_CORS_ORIGINS=*

# Serve defaults (bind 127.0.0.1 for local demos; set CURIOSITY_API_KEY before 0.0.0.0)
# CURIOSITY_HOST=127.0.0.1
# CURIOSITY_PORT=8000

# MCP progressive disclosure (core | investigate | affect | research | full — default full)
# `full` includes all tool groups; other tiers expose their documented subset.
# CURIOSITY_MCP_TIER=full

# See artificial_emotions.config for the central env reference.
