  {
    "type": "function",
    "function": {
      "name": "mix_emotions",
      "description": "Mix catalog emotions by percentages/weights (normalized to sum 1.0). Example weights: {curiosity: 40, confusion: 30, awe: 30}. Returns blend profile, cue tags, inject_fragment. Annotation only \u2014 does not feel.",
      "parameters": {
        "type": "object",
        "properties": {
          "weights": {
            "type": "object",
            "description": "Map emotion_id \u2192 percent (e.g. 40) or weight (e.g. 0.4). Normalized to sum 1.0. Example: {\"curiosity\": 40, \"confusion\": 30, \"awe\": 30}",
            "additionalProperties": {
              "type": "number"
            }
          },
          "profile_name": {
            "type": "string",
            "description": "Optional ValueProfile for mix_intensity_cap"
          },
          "mix_intensity_cap": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Override non-epistemic mix mass cap"
          }
        },
        "required": [
          "weights"
        ],
        "additionalProperties": false
      }
    }
